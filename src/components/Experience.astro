---
// src/components/Experience.astro
import { getYearsOfExperience, getOutcodeTenureYears } from '../utils/experience';

const yearsExperience = getYearsOfExperience();
const outcodeTenureYears = getOutcodeTenureYears();
---

<section id="experience" class="section-wrapper">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <div class="section-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
          <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
        </svg>
        <span>Career Journey</span>
      </div>
      <h2 class="section-title">Experience & <span class="gradient-text">Education</span></h2>
      <p class="section-subtitle">Over <span data-dynamic-exp="years">{yearsExperience}</span> years of continuous growth across leading software agencies, product platforms, and academic institutions.</p>
    </div>

    <div class="timeline-grid">
      <!-- Left Column: Work Experience -->
      <div class="timeline-column work-column reveal-on-scroll delay-100" id="work-column">
        <div class="column-header">
          <div class="column-icon work-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
            </svg>
          </div>
          <div class="column-title-group">
            <h3 class="column-title">Work Experience</h3>
            <span class="column-subtitle"><span data-dynamic-exp="badge-years">{yearsExperience}+ Years</span> Continuous Production Delivery</span>
          </div>
        </div>

        <div class="timeline-track">
          <!-- Job 1: Outcode LLC -->
          <div class="timeline-card active-card">
            <div class="timeline-header-row">
              <div class="role-lead">
                <div class="exp-avatar avatar-outcode">OL</div>
                <div class="role-info">
                  <h4 class="role-title">Full-Stack Software Engineer</h4>
                  <div class="company-row">
                    <span class="company-name highlight-accent">Outcode LLC Nepal</span>
                    <span class="current-role-pill">
                      <span class="status-pulse-dot"></span>
                      <span>Current Role</span>
                    </span>
                  </div>
                </div>
              </div>
              <div class="timeline-period">
                <svg class="period-cal-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
                <span>Nov 2020 – Present</span>
                <span class="period-dot" aria-hidden="true">•</span>
                <span class="period-duration" data-dynamic-exp="outcode-years">{outcodeTenureYears}+ Years</span>
              </div>
            </div>

            <p class="role-desc">
              Leading full-stack architecture and microservices engineering for enterprise client applications. Collaborating with cross-functional international teams, mentoring engineers, and executing end-to-end production deliveries.
            </p>

            <ul class="role-highlights">
              <li>Architecting scalable backend microservices using Python, Django, and DRF.</li>
              <li>Building reactive frontend web interfaces with Angular and TypeScript.</li>
              <li>Integrating payment ecosystems (Stripe, Authorize.Net, PayPal) and AWS cloud infrastructure.</li>
            </ul>

            <div class="role-tech-tags">
              <span class="tech-badge">Python</span>
              <span class="tech-badge">Django / DRF</span>
              <span class="tech-badge">Angular</span>
              <span class="tech-badge">PostgreSQL</span>
              <span class="tech-badge">AWS</span>
              <span class="tech-badge">Stripe</span>
            </div>
          </div>

          <!-- Job 2: Insight Workshop -->
          <div class="timeline-card">
            <div class="timeline-header-row">
              <div class="role-lead">
                <div class="exp-avatar avatar-insight">IW</div>
                <div class="role-info">
                  <h4 class="role-title">Software Engineer</h4>
                  <div class="company-name highlight-cyan">Insight Workshop Pvt Ltd</div>
                </div>
              </div>
              <div class="timeline-period">
                <svg class="period-cal-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
                <span>Jun 2018 – Nov 2020</span>
                <span class="period-dot" aria-hidden="true">•</span>
                <span class="period-duration">2.5 Years</span>
              </div>
            </div>

            <p class="role-desc">
              Engineered scalable backend RESTful APIs, optimized complex relational queries, and implemented third-party service integrations including messaging and CRM workflows.
            </p>

            <ul class="role-highlights">
              <li>Developed REST APIs handling high-throughput web requests.</li>
              <li>Integrated Twilio SMS/voice gateways and external CRM APIs.</li>
            </ul>

            <div class="role-tech-tags">
              <span class="tech-badge">Python</span>
              <span class="tech-badge">Django</span>
              <span class="tech-badge">REST APIs</span>
              <span class="tech-badge">MySQL</span>
              <span class="tech-badge">Twilio</span>
            </div>
          </div>

          <!-- Job 3: Slash Plus -->
          <div class="timeline-card">
            <div class="timeline-header-row">
              <div class="role-lead">
                <div class="exp-avatar avatar-slash">S+</div>
                <div class="role-info">
                  <h4 class="role-title">Web Developer</h4>
                  <div class="company-name">Slash Plus</div>
                </div>
              </div>
              <div class="timeline-period">
                <svg class="period-cal-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
                <span>Mar 2016 – Jun 2018</span>
                <span class="period-dot" aria-hidden="true">•</span>
                <span class="period-duration">2+ Years</span>
              </div>
            </div>

            <p class="role-desc">
              Developed custom CMS and commercial web applications. Handled front-to-back development, database schema modeling, and client requirement analysis.
            </p>

            <div class="role-tech-tags">
              <span class="tech-badge">PHP</span>
              <span class="tech-badge">Laravel</span>
              <span class="tech-badge">CodeIgniter</span>
              <span class="tech-badge">JavaScript</span>
              <span class="tech-badge">MySQL</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Education -->
      <div class="timeline-column edu-column reveal-on-scroll delay-200" id="edu-column">
        <div class="column-header">
          <div class="column-icon edu-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
              <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
            </svg>
          </div>
          <div class="column-title-group">
            <h3 class="column-title">Educational Background</h3>
            <span class="column-subtitle">Masters & Bachelors Degrees</span>
          </div>
        </div>

        <div class="timeline-track">
          <!-- Degree 1: Lincoln University MCS -->
          <div class="timeline-card">
            <div class="timeline-header-row">
              <div class="role-lead">
                <div class="exp-avatar avatar-lincoln">LU</div>
                <div class="role-info">
                  <h4 class="role-title">Master of Computer Science (MCS)</h4>
                  <div class="company-name highlight-cyan">Lincoln University • Postgraduate</div>
                </div>
              </div>
              <div class="timeline-period">
                <svg class="period-cal-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
                <span>2021 – 2023</span>
              </div>
            </div>

            <p class="role-desc">
              Advanced graduate studies focused on distributed software systems, advanced algorithm design, software architecture patterns, and research in computer science.
            </p>

            <div class="role-tech-tags">
              <span class="tech-badge">Distributed Systems</span>
              <span class="tech-badge">Algorithms</span>
              <span class="tech-badge">Software Architecture</span>
            </div>
          </div>

          <!-- Degree 2: TU Nepal BSc.CSIT -->
          <div class="timeline-card">
            <div class="timeline-header-row">
              <div class="role-lead">
                <div class="exp-avatar avatar-tu">TU</div>
                <div class="role-info">
                  <h4 class="role-title">BSc. Computer Science & IT (BSc.CSIT)</h4>
                  <div class="company-name">Tribhuvan University (TU), Nepal • Undergraduate</div>
                </div>
              </div>
              <div class="timeline-period">
                <svg class="period-cal-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
                <span>2011 – 2015</span>
              </div>
            </div>

            <p class="role-desc">
              Comprehensive 4-year undergraduate curriculum in computing theory, operating systems, compiler design, database architecture, and computer network protocols.
            </p>

            <div class="role-tech-tags">
              <span class="tech-badge">Operating Systems</span>
              <span class="tech-badge">Computer Networks</span>
              <span class="tech-badge">Database Design</span>
              <span class="tech-badge">C / C++</span>
            </div>
          </div>

          <!-- Degree 3: NAST HSEB -->
          <div class="timeline-card">
            <div class="timeline-header-row">
              <div class="role-lead">
                <div class="exp-avatar avatar-nast">NS</div>
                <div class="role-info">
                  <h4 class="role-title">+2 High School Science</h4>
                  <div class="company-name">NAST, HSEB Nepal • High School</div>
                </div>
              </div>
              <div class="timeline-period">
                <svg class="period-cal-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"></rect><line x1="16" x2="16" y1="2" y2="6"></line><line x1="8" x2="8" y1="2" y2="6"></line><line x1="3" x2="21" y1="10" y2="10"></line></svg>
                <span>2008 – 2012</span>
              </div>
            </div>

            <p class="role-desc">
              Secondary education with specialization in Mathematics and Physics, establishing foundational logical thinking and scientific principles.
            </p>

            <div class="role-tech-tags">
              <span class="tech-badge">Mathematics</span>
              <span class="tech-badge">Physics</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Grid Layout with Separator */
  .timeline-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    position: relative;
  }

  @media (min-width: 960px) {
    .timeline-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(3.5rem, 6vw, 5rem);
    }

    /* Vertical Separating Line on Desktop */
    .timeline-grid::after {
      content: "";
      position: absolute;
      top: 15px;
      bottom: 15px;
      left: 50%;
      width: 1px;
      transform: translateX(-50%);
      background: linear-gradient(
        180deg,
        rgba(34, 197, 94, 0.45) 0%,
        rgba(56, 189, 248, 0.35) 45%,
        rgba(255, 255, 255, 0.05) 100%
      );
    }

    /* Anchor Node on Desktop */
    .timeline-grid::before {
      content: "";
      position: absolute;
      top: 15px;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--color-accent);
      box-shadow: 0 0 8px var(--color-accent);
      z-index: 2;
    }
  }

  /* Horizontal Separating Line on Mobile */
  @media (max-width: 959px) {
    .work-column {
      padding-bottom: clamp(2rem, 5vw, 3rem);
      position: relative;
    }

    .work-column::after {
      content: "";
      position: absolute;
      bottom: 0;
      left: 5%;
      right: 5%;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent 0%,
        rgba(34, 197, 94, 0.4) 25%,
        rgba(56, 189, 248, 0.4) 75%,
        transparent 100%
      );
    }
  }

  /* Column Header */
  .column-header {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: var(--space-lg);
  }

  .column-icon {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .work-icon {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  .edu-icon {
    background: rgba(56, 189, 248, 0.12);
    color: var(--color-cyan);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .column-title-group {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .column-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.25;
  }

  .column-subtitle {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  /* Timeline Track */
  .timeline-track {
    display: flex;
    flex-direction: column;
    gap: 20px;
    position: relative;
  }

  .timeline-card {
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    padding: clamp(1.25rem, 3vw, 1.75rem);
    position: relative;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .timeline-card:hover {
    border-color: var(--color-card-hover-border);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .active-card {
    border-color: rgba(34, 197, 94, 0.35);
    background: linear-gradient(180deg, rgba(34, 197, 94, 0.04) 0%, var(--color-card) 100%);
  }

  /* Header Row & Avatar */
  .timeline-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }

  .role-lead {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }

  .role-info {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .exp-avatar {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    flex-shrink: 0;
    margin-top: 2px;
  }

  .avatar-outcode {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .avatar-insight {
    background: rgba(56, 189, 248, 0.12);
    color: var(--color-cyan);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .avatar-slash {
    background: rgba(168, 85, 247, 0.12);
    color: var(--color-purple);
    border: 1px solid rgba(168, 85, 247, 0.25);
  }

  .avatar-lincoln {
    background: rgba(56, 189, 248, 0.12);
    color: var(--color-cyan);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .avatar-tu {
    background: rgba(245, 158, 11, 0.12);
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.25);
  }

  .avatar-nast {
    background: rgba(148, 163, 184, 0.12);
    color: #94A3B8;
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  .role-title {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.3;
  }

  .company-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .company-name {
    font-size: 0.875rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .highlight-accent {
    color: var(--color-accent);
    font-weight: 600;
  }

  .highlight-cyan {
    color: var(--color-cyan);
    font-weight: 600;
  }

  .current-role-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--color-accent-subtle);
    border: 1px solid rgba(34, 197, 94, 0.35);
    color: var(--color-accent);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status-pulse-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 6px var(--color-accent);
  }

  .timeline-period {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-muted);
    background: var(--badge-bg);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--badge-border);
    white-space: nowrap;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }

  .timeline-period:hover {
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
  }

  .period-cal-icon {
    color: var(--color-muted);
    flex-shrink: 0;
  }

  .period-dot {
    opacity: 0.4;
    font-size: 0.75rem;
    user-select: none;
  }

  .period-duration {
    color: var(--color-foreground);
    font-weight: 600;
    font-size: 0.75rem;
    letter-spacing: 0.01em;
  }

  .active-card .timeline-period {
    background: var(--color-accent-subtle);
    border-color: rgba(34, 197, 94, 0.3);
    color: var(--color-accent);
  }

  .active-card .timeline-period .period-cal-icon {
    color: var(--color-accent);
  }

  .active-card .timeline-period .period-duration {
    color: var(--color-accent);
  }

  .role-desc {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.7;
    margin-bottom: 12px;
  }

  .role-highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 14px 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .role-highlights li {
    position: relative;
    padding-left: 16px;
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.6;
  }

  .role-highlights li::before {
    content: "•";
    position: absolute;
    left: 4px;
    color: var(--color-accent);
    font-weight: bold;
  }

  .role-tech-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  /* Light Theme Specifics */
  html[data-theme="light"] .timeline-card {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }

  html[data-theme="light"] .timeline-card:hover {
    border-color: rgba(22, 163, 74, 0.4);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.08);
  }

  html[data-theme="light"] .timeline-period {
    background: #F1F5F9;
    border-color: #E2E8F0;
    color: #475569;
  }

  html[data-theme="light"] .timeline-period:hover {
    background: #E2E8F0;
    border-color: #CBD5E1;
  }

  html[data-theme="light"] .period-cal-icon {
    color: #64748B;
  }

  html[data-theme="light"] .period-dot {
    color: #94A3B8;
  }

  html[data-theme="light"] .period-duration {
    color: #0F172A;
  }

  html[data-theme="light"] .active-card .timeline-period {
    background: rgba(22, 163, 74, 0.08);
    border-color: rgba(22, 163, 74, 0.25);
    color: #166534;
  }

  html[data-theme="light"] .active-card .timeline-period .period-cal-icon {
    color: #16A34A;
  }

  html[data-theme="light"] .active-card .timeline-period .period-duration {
    color: #15803D;
  }

  html[data-theme="light"] .timeline-grid::after {
    background: linear-gradient(
      180deg,
      rgba(22, 163, 74, 0.45) 0%,
      rgba(2, 132, 199, 0.35) 45%,
      rgba(203, 213, 225, 0.6) 100%
    );
  }

