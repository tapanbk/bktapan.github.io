---
// src/components/Hero.astro
---

<section id="hero" class="hero-section">
  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Left Column: Copy & CTAs -->
      <div class="hero-content">
        <!-- Live Status Badge -->
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>Full-Stack Engineer at Outcode LLC</span>
        </div>

        <h1 class="hero-headline">
          Architecting robust <span class="gradient-text">backend engines</span> & modern web interfaces.
        </h1>

        <p class="hero-description">
          Hi, I'm <strong class="text-white">Tapan B.K.</strong> — a Full-Stack Software Engineer with over 8 years of professional experience building scalable distributed systems, RESTful microservices, and reactive frontends across Nepal and global teams.
        </p>

        <!-- CTA Action Group -->
        <div class="hero-cta-group">
          <a href="#contact" class="btn btn-primary">
            <span>Discuss a Project</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <a href="#experience" class="btn btn-secondary">
            <span>Career Timeline</span>
          </a>

          <a href="https://github.com/tapanbk" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-icon-only" aria-label="Visit Tapan's GitHub profile" title="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        </div>

        <!-- Metric highlights -->
        <div class="metrics-grid">
          <div class="metric-item">
            <div class="metric-value font-mono">8+</div>
            <div class="metric-label">Years Experience</div>
          </div>
          <div class="metric-item">
            <div class="metric-value font-mono">Nov 2020+</div>
            <div class="metric-label">Senior at Outcode</div>
          </div>
          <div class="metric-item">
            <div class="metric-value font-mono">MCS & BSc</div>
            <div class="metric-label">Computer Science</div>
          </div>
          <div class="metric-item">
            <div class="metric-value font-mono">100%</div>
            <div class="metric-label">Production Delivery</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Dev Terminal Card -->
      <div class="hero-terminal">
        <div class="terminal-card font-mono">
          <!-- Terminal Header -->
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="terminal-title">tapan@dev: ~/profile.py</div>
            <div class="terminal-lang">Python 3.12</div>
          </div>

          <!-- Code Body -->
          <div class="terminal-body">
            <pre class="terminal-code"><code><span class="code-comment"># Engineer Specification</span>
<span class="code-keyword">class</span> <span class="code-class">FullStackEngineer</span>:
    name = <span class="code-string">"Tapan B.K."</span>
    title = <span class="code-string">"Full Stack Software Engineer"</span>
    company = <span class="code-string">"Outcode LLC Nepal"</span>
    location = <span class="code-string">"Patan Dhoka, Lalitpur, Nepal"</span>
    status = <span class="code-string">"🟢 Active / Available"</span>
    
    core_stack = [
        <span class="code-string">"Python / Django / DRF"</span>,
        <span class="code-string">"Angular / Astro / TypeScript"</span>,
        <span class="code-string">"PostgreSQL / MySQL / Firestore"</span>,
        <span class="code-string">"AWS / Docker / Linux"</span>
    ]

    <span class="code-keyword">def</span> <span class="code-func">solve_problem</span>(self, requirements):
        <span class="code-keyword">return</span> <span class="code-string">"Scalable, resilient & secure software."</span>

<span class="code-prompt">$</span> python profile.py
<span class="code-output">✓ 8+ years building high-impact tech.</span>
<span class="code-output">✓ Ready for new challenges.</span>
<span class="code-prompt">$</span> <span class="code-cursor">█</span></code></pre>
          </div>

          <!-- Interactive Terminal Footer -->
          <div class="terminal-footer">
            <div class="terminal-status">
              <span class="terminal-status-light"></span>
              <span>REST API: 200 OK (14ms)</span>
            </div>
            <a href="mailto:bktapan16@gmail.com" class="terminal-mail-btn">
              <span>Ping Me</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: var(--color-accent-subtle);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: var(--radius-full);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    font-family: var(--font-mono);
    margin-bottom: var(--space-md);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    box-shadow: 0 0 6px var(--color-accent);
  }

  /* Headline */
  .hero-headline {
    margin-bottom: var(--space-md);
    letter-spacing: -0.03em;
  }

  .gradient-text {
    background: linear-gradient(135deg, #38BDF8 0%, #22C55E 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-white {
    color: var(--color-foreground);
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--color-text-body);
    line-height: 1.7;
    margin-bottom: var(--space-xl);
    max-width: 600px;
  }

  /* CTA Group */
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .btn-icon-only {
    width: 48px;
    height: 48px;
    padding: 0;
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-card-border);
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .metric-item {
    display: flex;
    flex-direction: column;
  }

  .metric-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.2;
  }

  .metric-label {
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: 2px;
  }

  /* Terminal Card */
  .terminal-card {
    background: var(--terminal-bg);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg), 0 0 40px rgba(34, 197, 94, 0.08);
    overflow: hidden;
    transition: transform 250ms ease, border-color 250ms ease, box-shadow 250ms ease;
  }

  .terminal-card:hover {
    border-color: rgba(34, 197, 94, 0.3);
    transform: translateY(-2px);
  }

  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--terminal-header-bg);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #EF4444; }
  .dot-yellow { background: #F59E0B; }
  .dot-green { background: #10B981; }

  .terminal-title {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .terminal-lang {
    font-size: 0.75rem;
    color: var(--color-subtle);
  }

  .terminal-body {
    padding: 16px;
    font-size: 0.8125rem;
    line-height: 1.6;
    overflow-x: auto;
  }

  .terminal-code {
    margin: 0;
  }

  /* Syntax Highlighting */
  .code-comment { color: #64748B; }
  .code-keyword { color: #F43F5E; font-weight: 600; }
  .code-class { color: #38BDF8; font-weight: 600; }
  .code-func { color: #A855F7; }
  .code-string { color: #22C55E; }
  .code-prompt { color: #38BDF8; }
  .code-output { color: #E2E8F0; display: block; }
  .code-cursor {
    color: var(--color-accent);
    animation: blinkCursor 1s infinite steps(2, start);
  }

  @keyframes blinkCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .terminal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 16px;
    background: var(--terminal-header-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
  }

  .terminal-status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-muted);
  }

  .terminal-status-light {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--color-accent);
  }

  .terminal-mail-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-accent);
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--color-accent-subtle);
    transition: background 150ms ease;
  }

  .terminal-mail-btn:hover {
    background: rgba(34, 197, 94, 0.2);
  }
</style>
