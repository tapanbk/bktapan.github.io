---
// src/components/Hero.astro
import { getYearsOfExperience } from '../utils/experience';

const yearsExperience = getYearsOfExperience();
---

<section id="hero" class="hero-section">
  <div class="container hero-container">
    <div class="hero-grid">
      <!-- Left Column: Copy & CTAs -->
      <div class="hero-content reveal-on-scroll">
        <!-- Live Status Badge -->
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span>Full-Stack Engineer at Outcode LLC</span>
        </div>

        <h1 class="hero-headline">
          Architecting robust <span class="gradient-text">backend engines</span> & modern web interfaces.
        </h1>

        <p class="hero-description">
          Hi, I'm <strong class="text-white">Tapan B.K.</strong> — a Full-Stack Software Engineer with over <span data-dynamic-exp="years">{yearsExperience}</span> years of professional experience building scalable distributed systems, RESTful microservices, and reactive frontends across Nepal and global teams.
        </p>

        <!-- CTA Action Group -->
        <div class="hero-cta-group">
          <a href="#contact" class="btn btn-primary">
            <span>Discuss a Project</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </a>

          <a href="#experience" class="btn btn-secondary">
            <span>Career Timeline</span>
          </a>

          <a href="https://github.com/tapanbk" target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-icon-only" aria-label="Visit Tapan's GitHub profile" title="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        </div>

        <!-- Metric highlights Bento Grid -->
        <div class="metrics-grid">
          <div class="metric-card reveal-on-scroll delay-100">
            <div class="metric-top">
              <span class="metric-icon-wrap icon-green">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
              </span>
              <span class="metric-badge">Proven</span>
            </div>
            <div class="metric-value" data-dynamic-exp="badge">{yearsExperience}+</div>
            <div class="metric-label">Years Experience</div>
          </div>

          <div class="metric-card reveal-on-scroll delay-150">
            <div class="metric-top">
              <span class="metric-icon-wrap icon-cyan">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>
              </span>
              <span class="metric-badge">Outcode</span>
            </div>
            <div class="metric-value">Nov 2020+</div>
            <div class="metric-label">Senior at Outcode</div>
          </div>

          <div class="metric-card reveal-on-scroll delay-200">
            <div class="metric-top">
              <span class="metric-icon-wrap icon-purple">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.42 10.922a1 1 0 0 0-.019-.838L12.83 3.18a2 2 0 0 0-1.66 0L2.6 10.084a1 1 0 0 0 0 1.832l8.57 6.908a2 2 0 0 0 1.66 0l8.57-6.9a1 1 0 0 0 .02-.002Z"></path><path d="M6 12v5c3 3 9 3 12 0v-5"></path></svg>
              </span>
              <span class="metric-badge">Education</span>
            </div>
            <div class="metric-value">MCS & BSc</div>
            <div class="metric-label">Computer Science</div>
          </div>

          <div class="metric-card reveal-on-scroll delay-250">
            <div class="metric-top">
              <span class="metric-icon-wrap icon-green">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><path d="m9 12 2 2 4-4"></path></svg>
              </span>
              <span class="metric-badge">Delivery</span>
            </div>
            <div class="metric-value">100%</div>
            <div class="metric-label">Production Delivery</div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Dev Terminal Card -->
      <div class="hero-terminal reveal-on-scroll delay-200">
        <div class="terminal-card font-mono">
          <!-- Editor Window / Tab Bar -->
          <div class="terminal-header">
            <div class="terminal-dots">
              <span class="dot dot-red"></span>
              <span class="dot dot-yellow"></span>
              <span class="dot dot-green"></span>
            </div>
            <div class="editor-tabs">
              <div class="editor-tab active-tab">
                <svg class="tab-py-icon" viewBox="0 0 24 24" width="13" height="13" fill="currentColor">
                  <path d="M11.91 0c-4.48 0-4.19 1.94-4.19 1.94l.01 2.01h4.26v.6H6.01S3 4.2 3 8.7c0 4.5 2.63 4.34 2.63 4.34h1.57v-2.17s-.08-2.58 2.54-2.58h4.39s2.46.04 2.46-2.4V4.35S16.99 0 11.91 0zm-2.3 1.25a.8.8 0 1 1 0 1.6.8.8 0 0 1 0-1.6zm6.39 6.05v2.17s.08 2.58-2.54 2.58h-4.39s-2.46-.04-2.46 2.4v1.54s-.41 4.35 4.67 4.35c4.48 0 4.19-1.94 4.19-1.94l-.01-2.01h-4.26v-.6h5.98s3.01.35 3.01-4.15c0-4.5-2.63-4.34-2.63-4.34h-1.57zm-2.09 13.85a.8.8 0 1 1 0-1.6.8.8 0 0 1 0 1.6z"/>
                </svg>
                <span>profile.py</span>
                <span class="tab-close">×</span>
              </div>
            </div>
            <div class="terminal-lang font-mono">Python 3.12</div>
          </div>

          <!-- Code Body -->
          <div class="terminal-body">
            <pre class="terminal-code"><code><span class="code-keyword">from</span> dataclasses <span class="code-keyword">import</span> <span class="code-builtin">dataclass</span>

<span class="code-decorator">@dataclass</span>
<span class="code-keyword">class</span> <span class="code-class">Engineer</span>:
    name: <span class="code-builtin">str</span> = <span class="code-string">"Tapan B.K."</span>
    role: <span class="code-builtin">str</span> = <span class="code-string">"Senior Full-Stack Engineer"</span>
    company: <span class="code-builtin">str</span> = <span class="code-string">"Outcode LLC"</span>
    stack: <span class="code-builtin">tuple</span> = (<span class="code-string">"Python"</span>, <span class="code-string">"Django"</span>, <span class="code-string">"Angular"</span>, <span class="code-string">"AWS"</span>)

    <span class="code-keyword">def</span> <span class="code-func">summary</span>(<span class="code-param">self</span>) -&gt; <span class="code-builtin">str</span>:
        <span class="code-keyword">return</span> <span class="code-string">f"&#123;self.name&#125; | &#123;self.role&#125; @ &#123;self.company&#125;"</span>

    <span class="code-keyword">def</span> <span class="code-func">deploy</span>(<span class="code-param">self</span>) -&gt; <span class="code-builtin">str</span>:
        techs = <span class="code-string">", "</span>.join(<span class="code-param">self</span>.stack)
        <span class="code-keyword">return</span> <span class="code-string">f"✓ Scalable system built with &#123;techs&#125;"</span>

<span class="code-keyword">if</span> __name__ == <span class="code-string">"__main__"</span>:
    dev = <span class="code-class">Engineer</span>()
    <span class="code-func">print</span>(dev.summary())
    <span class="code-func">print</span>(dev.deploy())
    <span class="code-func">print</span>(<span class="code-string">"✓ Ready for new architectural challenges"</span>)</code></pre>
          </div>

          <!-- Terminal Output Pane -->
          <div class="terminal-drawer">
            <div class="drawer-header">
              <div class="drawer-tag font-mono">
                <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"></polyline><line x1="12" y1="19" x2="20" y2="19"></line></svg>
                <span>TERMINAL</span>
              </div>
              <span class="drawer-path font-mono">~/tapan-bk</span>
            </div>
            <pre class="terminal-output-code"><code><span class="code-prompt">$</span> <span class="code-cmd">python profile.py</span>
<span class="code-output">Tapan B.K. | Senior Full-Stack Engineer @ Outcode LLC</span>
<span class="code-output"><span class="code-check">✓</span> Scalable system built with Python, Django, Angular, AWS</span>
<span class="code-output"><span class="code-check">✓</span> Ready for new architectural challenges</span>
<span class="code-prompt">$</span> <span class="code-cursor">█</span></code></pre>
          </div>

          <!-- Interactive Terminal Footer -->
          <div class="terminal-footer">
            <div class="terminal-status">
              <span class="terminal-status-light"></span>
              <span>Python 3.12 • UTF-8</span>
            </div>
            <a href="mailto:bktapan16@gmail.com" class="terminal-mail-btn">
              <span>Ping Me</span>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(3rem, 7vw, 5.5rem);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  /* Badge */
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: var(--color-accent-subtle);
    border: 1px solid rgba(34, 197, 94, 0.3);
    border-radius: var(--radius-full);
    color: var(--color-accent);
    font-size: 0.8125rem;
    font-weight: 600;
    font-family: var(--font-sans);
    letter-spacing: 0.02em;
    margin-bottom: var(--space-md);
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: var(--radius-full);
    box-shadow: 0 0 6px var(--color-accent);
  }

  /* Headline */
  .hero-headline {
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
    margin-bottom: var(--space-md);
  }

  .gradient-text {
    background: linear-gradient(135deg, #38BDF8 0%, #22C55E 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .text-white {
    color: var(--color-foreground);
    font-weight: 600;
  }

  .hero-description {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--color-text-body);
    line-height: 1.75;
    letter-spacing: 0;
    margin-bottom: var(--space-xl);
    max-width: 62ch;
    text-wrap: pretty;
  }

  /* CTA Group */
  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .btn-icon-only {
    width: 48px;
    height: 48px;
    padding: 0;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
                background-color 200ms ease,
                border-color 200ms ease,
                color 200ms ease,
                box-shadow 220ms ease;
  }

  .btn-icon-only svg {
    transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: center;
  }

  .btn-icon-only:hover {
    transform: translateY(-3px) scale(1.05);
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.45);
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05));
    box-shadow: 0 10px 24px -2px rgba(255, 255, 255, 0.18), 0 4px 8px rgba(0, 0, 0, 0.35);
  }

  .btn-icon-only:hover svg {
    transform: scale(1.15);
  }

  .btn-icon-only:active {
    transform: translateY(-1px) scale(0.97);
  }

  html[data-theme="light"] .btn-icon-only:hover {
    color: #FFFFFF;
    background: #181717;
    border-color: #181717;
    box-shadow: 0 10px 24px -2px rgba(24, 23, 23, 0.35), 0 4px 8px rgba(24, 23, 23, 0.12);
  }

  /* Metrics Bento Grid (2x2 grid for spacious layout) */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-card-border);
  }

  @media (min-width: 640px) {
    .metrics-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  .metric-card {
    display: flex;
    flex-direction: column;
    padding: 12px 14px;
    background: var(--badge-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
  }

  .metric-card:hover {
    transform: translateY(-2px);
    border-color: rgba(34, 197, 94, 0.4);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  html[data-theme="light"] .metric-card {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04);
  }

  html[data-theme="light"] .metric-card:hover {
    border-color: rgba(22, 163, 74, 0.4);
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.08);
  }

  .metric-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .metric-icon-wrap {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .metric-icon-wrap.icon-green {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
  }

  .metric-icon-wrap.icon-cyan {
    background: rgba(56, 189, 248, 0.12);
    color: var(--color-cyan);
  }

  .metric-icon-wrap.icon-purple {
    background: rgba(168, 85, 247, 0.12);
    color: var(--color-purple);
  }

  .metric-badge {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-value {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.15;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .metric-label {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Terminal Card */
  .terminal-card {
    background: #0D1525;
    border: 1px solid rgba(56, 189, 248, 0.16);
    border-radius: var(--radius-lg);
    box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.65), 0 0 30px -5px rgba(56, 189, 248, 0.08);
    overflow: hidden;
    transition: transform 250ms ease, border-color 250ms ease, box-shadow 250ms ease;
  }

  .terminal-card:hover {
    border-color: rgba(56, 189, 248, 0.35);
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -8px rgba(0, 0, 0, 0.75), 0 0 40px -5px rgba(56, 189, 248, 0.14);
  }

  /* Terminal Header & Editor Tabs */
  .terminal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 16px;
    height: 42px;
    background: #080E1B;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .terminal-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-red { background: #EF4444; }
  .dot-yellow { background: #F59E0B; }
  .dot-green { background: #10B981; }

  .editor-tabs {
    display: flex;
    align-items: center;
    height: 100%;
    gap: 4px;
  }

  .editor-tab {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 100%;
    padding: 0 14px;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: #94A3B8;
    background: transparent;
    border-bottom: 2px solid transparent;
    transition: all 150ms ease;
  }

  .editor-tab.active-tab {
    background: rgba(13, 21, 37, 0.85);
    color: #F8FAFC;
    border-bottom: 2px solid #38BDF8;
    font-weight: 500;
  }

  .tab-py-icon {
    color: #38BDF8;
    flex-shrink: 0;
  }

  .tab-close {
    font-size: 13px;
    line-height: 1;
    opacity: 0.45;
    margin-left: 2px;
    cursor: default;
  }

  .terminal-lang {
    font-size: 0.6875rem;
    color: #38BDF8;
    background: rgba(56, 189, 248, 0.1);
    padding: 2px 8px;
    border-radius: var(--radius-full);
    border: 1px solid rgba(56, 189, 248, 0.2);
  }

  .terminal-body {
    padding: 14px 16px;
    font-size: 0.8125rem;
    line-height: 1.45;
    overflow-x: auto;
    color: #E2E8F0;
    background: #0D1525;
  }

  .terminal-code {
    margin: 0;
    font-family: var(--font-mono);
    font-feature-settings: 'zero' 1;
    letter-spacing: -0.01em;
  }

  /* Refined Developer Dark Syntax Highlighting */
  .code-comment { color: #64748B; font-style: italic; }
  .code-keyword { color: #C084FC; font-weight: 600; }
  .code-decorator { color: #38BDF8; font-weight: 500; }
  .code-builtin { color: #67E8F9; }
  .code-class { color: #60A5FA; font-weight: 600; }
  .code-func { color: #93C5FD; }
  .code-param { color: #FDA4AF; }
  .code-string { color: #4ADE80; }
  .code-prompt { color: #38BDF8; font-weight: 600; }
  .code-cmd { color: #F8FAFC; font-weight: 600; }
  .code-output { color: #CBD5E1; }
  .code-check { color: #22C55E; font-weight: 700; }
  .code-cursor {
    color: #38BDF8;
    animation: blinkCursor 1s infinite steps(2, start);
  }

  @keyframes blinkCursor {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  /* Terminal Drawer (Execution Output) */
  .terminal-drawer {
    background: #080E1B;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding: 12px 16px;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }

  .drawer-tag {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #38BDF8;
    letter-spacing: 0.06em;
  }

  .drawer-path {
    font-size: 0.6875rem;
    color: #64748B;
  }

  .terminal-output-code {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    line-height: 1.55;
    color: #CBD5E1;
  }

  .terminal-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 16px;
    background: #080E1B;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
  }

  .terminal-status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-muted);
  }

  .terminal-status-light {
    width: 6px;
    height: 6px;
    background: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 6px var(--color-accent);
  }

  .terminal-mail-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--color-accent);
    padding: 4px 8px;
    border-radius: 4px;
    background: var(--color-accent-subtle);
    transition: background 150ms ease;
  }

  .terminal-mail-btn:hover {
    background: rgba(34, 197, 94, 0.2);
  }

  /* ==========================================================================
     Light Mode Terminal Editor Theme (Authentic IDE in Light Mode)
     ========================================================================== */
  html[data-theme="light"] .terminal-card,
  :root[data-theme="light"] .terminal-card {
    background: #FFFFFF;
    border: 1px solid #E2E8F0;
