---
// src/components/About.astro
---

<section id="about" class="section-wrapper">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <div class="section-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 16v-4"></path>
          <path d="M12 8h.01"></path>
        </svg>
        <span>Profile & Background</span>
      </div>
      <h2 class="section-title">Engineering with Purpose & Precision</h2>
      <p class="section-subtitle">A glimpse into my background, engineering philosophy, and day-to-day focus as a senior practitioner.</p>
    </div>

    <!-- Bento Grid Layout -->
    <div class="about-bento-grid">
      <!-- Bento 1: Primary Story Card (Span 2) -->
      <div class="bento-card bio-card reveal-on-scroll delay-100">
        <div class="card-glow-corner"></div>
        <div class="bio-header">
          <div class="bio-avatar-container">
            <img src="/img/about/1.jpg" alt="Tapan B.K." class="bio-avatar" width="96" height="96" />
          </div>
          <div>
            <h3 class="bio-name">Tapan B.K.</h3>
            <p class="bio-tagline">Senior Full-Stack Engineer at <span class="highlight">Outcode LLC</span></p>
            <div class="bio-location">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>Patan Dhoka, Lalitpur, Nepal</span>
            </div>
          </div>
        </div>

        <div class="bio-text">
          <p>
            I am a full stack software engineer working as a full-time engineer at <strong>OutCode LLC Nepal</strong>. For the past <strong>8+ years</strong>, I have designed, engineered, and maintained web systems that process mission-critical data with high reliability.
          </p>
          <p>
            My engineering foundation started in PHP (Laravel and CodeIgniter) before deepening into <strong>Python (Django / Django REST Framework)</strong> and modern frontends including <strong>Angular and TypeScript</strong>. Over nearly a decade, I have architected cloud systems on AWS and GCP, integrated complex payment gateways (Stripe, Authorize.net), managed distributed relational and NoSQL databases, and led agile delivery cycles.
          </p>
          <p>
            I take genuine pride in every phase of the engineering lifecycle: from collaborating on initial software requirements to writing clean, maintainable code and seeing projects thrive in production.
          </p>
        </div>
      </div>

      <!-- Bento 2: Quick Information Card -->
      <div class="bento-card meta-card reveal-on-scroll delay-200">
        <div class="card-glow-corner"></div>

        <div class="meta-card-header">
          <div class="meta-header-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="18" height="18" x="3" y="3" rx="2"></rect>
              <path d="M7 7h10"></path>
              <path d="M7 12h10"></path>
              <path d="M7 17h6"></path>
            </svg>
          </div>
          <div>
            <h3 class="meta-card-title">Quick Information</h3>
            <span class="meta-card-subtitle">Profile & Key Details</span>
          </div>
        </div>

        <ul class="meta-list">
          <li class="meta-row">
            <div class="meta-row-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="meta-row-icon" aria-hidden="true">
                <rect width="20" height="14" x="2" y="7" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              <span class="meta-key">Role</span>
            </div>
            <span class="meta-val-badge">Full-Stack Engineer</span>
          </li>

          <li class="meta-row">
            <div class="meta-row-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="meta-row-icon" aria-hidden="true">
                <path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"></path>
                <path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
                <path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"></path>
                <path d="M10 6h4"></path>
                <path d="M10 10h4"></path>
                <path d="M10 14h4"></path>
                <path d="M10 18h4"></path>
              </svg>
              <span class="meta-key">Company</span>
            </div>
            <span class="meta-val-badge company-badge">Outcode LLC</span>
          </li>

          <li class="meta-row">
            <div class="meta-row-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="meta-row-icon" aria-hidden="true">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span class="meta-key">Location</span>
            </div>
            <span class="meta-val-text">Lalitpur, Nepal</span>
          </li>

          <li class="meta-row">
            <div class="meta-row-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="meta-row-icon" aria-hidden="true">
                <path d="M21.42 10.922a1 1 0 0 0-.019-.838L12.83 3.18a2 2 0 0 0-1.66 0L2.6 10.084a1 1 0 0 0 0 1.832l8.57 6.908a2 2 0 0 0 1.66 0l8.57-6.9a1 1 0 0 0 .02-.002Z"></path>
                <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
              </svg>
              <span class="meta-key">Education</span>
            </div>
            <span class="meta-val-text">MCS & BSc.CSIT</span>
          </li>

          <li class="meta-row">
            <div class="meta-row-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="meta-row-icon" aria-hidden="true">
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <span class="meta-key">Email</span>
            </div>
            <a href="mailto:bktapan16@gmail.com" class="meta-link" title="Email bktapan16@gmail.com">
              bktapan16@gmail.com
            </a>
          </li>

          <li class="meta-row">
            <div class="meta-row-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="meta-row-icon" aria-hidden="true">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              <span class="meta-key">Phone</span>
            </div>
            <a href="tel:+9779849716660" class="meta-link" title="Call +977-984-971-6660">
              +977-984-971-6660
            </a>
          </li>

          <li class="meta-row">
            <div class="meta-row-left">
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="meta-row-icon" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" x2="22" y1="12" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span class="meta-key">Website</span>
            </div>
            <a href="https://bktapan.com.np" target="_blank" rel="noopener noreferrer" class="meta-link" title="Visit bktapan.com.np">
              bktapan.com.np
            </a>
          </li>
        </ul>
      </div>

      <!-- Bento 3: Pillar 1 -->
      <div class="bento-card pillar-card reveal-on-scroll delay-150">
        <div class="pillar-icon-wrap icon-cyan">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="18" height="18" x="3" y="3" rx="2"></rect>
            <path d="M9 3v18"></path>
            <path d="m14 9 3 3-3 3"></path>
          </svg>
        </div>
        <h3 class="pillar-title">Scalable Backend Architecture</h3>
        <p class="pillar-desc">
          Specializing in Django, REST APIs, asynchronous queuing, and database query optimization for high-traffic environments.
        </p>
      </div>

      <!-- Bento 4: Pillar 2 -->
      <div class="bento-card pillar-card reveal-on-scroll delay-250">
        <div class="pillar-icon-wrap icon-green">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 2v20"></path>
            <path d="m17 5-5-3-5 3"></path>
            <path d="m17 19-5 3-5-3"></path>
            <path d="M2 12h20"></path>
            <path d="m5 7-3 5 3 5"></path>
            <path d="m19 7 3 5-3 5"></path>
          </svg>
        </div>
        <h3 class="pillar-title">End-to-End Ownership</h3>
        <p class="pillar-desc">
          Managing full lifecycles: from schema modeling, server provisioning (AWS/GCP), CI/CD pipelines to payment integrations.
        </p>
      </div>

      <!-- Bento 5: Pillar 3 -->
      <div class="bento-card pillar-card reveal-on-scroll delay-350">
        <div class="pillar-icon-wrap icon-purple">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
        </div>
        <h3 class="pillar-title">Collaborative Leadership</h3>
        <p class="pillar-desc">
          Experienced in cross-functional agile teams (Jira, ClickUp), conducting rigorous code reviews, and mentoring upcoming engineers.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about-bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 960px) {
    .about-bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .bio-card {
      grid-column: span 2;
    }

    .meta-card {
      grid-column: span 1;
    }
  }

  /* Bio card */
  .bio-header {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: var(--space-md);
    flex-wrap: wrap;
  }

  .bio-avatar-container {
    width: 88px;
    height: 88px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.15);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.5);
    flex-shrink: 0;
  }

  .bio-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bio-name {
    font-family: var(--font-display);
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    margin-bottom: 3px;
  }

  .bio-tagline {
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .highlight {
    color: var(--color-cyan);
    font-weight: 600;
  }

  .highlight-green {
    color: var(--color-accent);
    font-weight: 600;
  }

  .bio-location {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8125rem;
    color: var(--color-muted);
    margin-top: 4px;
  }

  .bio-text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    border-top: 1px solid var(--color-card-border);
    padding-top: var(--space-md);
  }

  .bio-text p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-text-body);
  }

  .bio-text strong {
    color: var(--color-foreground);
    font-weight: 600;
  }

  /* Meta Card Improvements */
  .meta-card {
    display: flex;
    flex-direction: column;
  }

  .meta-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-card-border);
  }

  .meta-header-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .meta-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1.2;
  }

  .meta-card-subtitle {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .meta-status-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background: var(--badge-bg);
    border: 1px solid rgba(34, 197, 94, 0.25);
    border-radius: var(--radius-md);
    margin-bottom: 14px;
    gap: 8px;
  }

  .status-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .status-pulse-dot {
    width: 8px;
    height: 8px;
    background-color: var(--color-accent);
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: pulse-green 2s infinite cubic-bezier(0.66, 0, 0, 1);
  }

  @keyframes pulse-green {
    0% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    }
    70% {
      box-shadow: 0 0 0 8px rgba(34, 197, 94, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(34, 197, 94, 0);
    }
  }

  .status-text {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-accent);
  }

  .status-badge {
    font-size: 0.6875rem;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    white-space: nowrap;
  }

  .meta-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .meta-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 5px 10px;
    border-radius: var(--radius-sm);
    background: var(--badge-bg);
    border: 1px solid var(--color-card-border);
    transition: all 150ms ease;
    gap: 12px;
  }

  .meta-row:hover {
    border-color: rgba(34, 197, 94, 0.3);
    background: var(--color-card);
  }

  .meta-row-left {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .meta-row-icon {
    color: var(--color-muted);
  }

  .meta-key {
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-weight: 500;
  }

  .meta-val-badge {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-foreground);
    text-align: right;
  }

  .company-badge {
    color: var(--color-cyan);
  }

  .meta-val-text {
    font-size: 0.8125rem;
    color: var(--color-foreground);
    text-align: right;
  }

  .meta-link {
    font-size: 0.8125rem;
    color: var(--color-cyan);
    text-align: right;
    transition: color 150ms ease;
    text-decoration: none;
    word-break: break-all;
  }

  .meta-link:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* Pillar cards */
  .pillar-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pillar-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-cyan {
    background: rgba(56, 189, 248, 0.12);
    color: var(--color-cyan);
    border: 1px solid rgba(56, 189, 248, 0.3);
  }

  .icon-green {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid rgba(34, 197, 94, 0.3);
  }

  .icon-purple {
    background: rgba(168, 85, 247, 0.12);
    color: var(--color-purple);
    border: 1px solid rgba(168, 85, 247, 0.3);
  }

  .pillar-title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-foreground);
    line-height: 1.35;
  }

  .pillar-desc {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.65;
  }
</style>
