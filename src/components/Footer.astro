---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <div class="footer-brand">TAPAN B.K.</div>
      <p class="footer-copy">
        © {currentYear} Tapan B.K. • Senior Full-Stack Software Engineer
      </p>
    </div>

  </div>
</footer>

<!-- Floating Back to Top Button (Fixed at bottom right of screen, visible after scrolling) -->
<button 
  id="floating-back-to-top" 
  class="floating-back-to-top" 
  aria-label="Back to top of page" 
  title="Scroll to top"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="m18 15-6-6-6 6"></path>
  </svg>
</button>

<style>
  .site-footer {
    border-top: 1px solid var(--color-card-border);
    padding: 32px 0;
    background: var(--footer-bg);
    transition: background-color 200ms ease;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
  }

  .footer-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .footer-brand {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-foreground);
    letter-spacing: 0.04em;
  }

  .footer-copy {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .footer-right {
    display: flex;
    align-items: center;
  }

  .footer-tech-tag {
    font-size: 0.75rem;
    color: var(--color-muted);
    padding: 6px 12px;
    background: var(--badge-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-full);
  }

  /* ==========================================================================
     Floating Back-to-Top Pill (Fixed to screen viewport bottom-right)
     ========================================================================== */
  .floating-back-to-top {
    position: fixed;
    bottom: 28px;
    right: 28px;
    z-index: 99;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
    color: var(--color-muted);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.9);
    transition: opacity 220ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1), visibility 220ms ease, background-color 150ms ease, border-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
  }

  .floating-back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .floating-back-to-top:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #06240E;
    transform: translateY(-3px) scale(1.08);
    box-shadow: 0 8px 24px rgba(34, 197, 94, 0.4);
  }

  .floating-back-to-top:active {
    transform: translateY(0) scale(0.96);
  }

  .floating-back-to-top svg {
    transition: transform 150ms ease;
    animation: gentleBounce 1.8s infinite ease-in-out;
  }

  @keyframes gentleBounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-4px);
    }
  }

  .floating-back-to-top:hover svg {
    animation: none;
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .floating-back-to-top svg {
      animation: none;
    }
  }

  html[data-theme="light"] .floating-back-to-top {
    background: #FFFFFF;
    border-color: #CBD5E1;
    color: #475569;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.12);
  }

  html[data-theme="light"] .floating-back-to-top:hover {
    background: #16A34A;
    border-color: #16A34A;
    color: #FFFFFF;
    box-shadow: 0 8px 20px rgba(22, 163, 74, 0.3);
  }
</style>

<script>
  const floatingBtn = document.getElementById('floating-back-to-top');

  if (floatingBtn) {
    const handleScroll = () => {
      // Show when scrolled down past 280px, hide at top of page
      if (window.scrollY > 280) {
        floatingBtn.classList.add('is-visible');
      } else {
        floatingBtn.classList.remove('is-visible');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    // Check initial state
    handleScroll();

    floatingBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
