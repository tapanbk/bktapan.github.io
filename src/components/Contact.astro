---
// src/components/Contact.astro
---

<section id="contact" class="section-wrapper">
  <div class="container">
    <div class="contact-card bento-card">
      <div class="card-glow-corner"></div>

      <div class="contact-header">
        <div class="section-badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"></path>
            <path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"></path>
          </svg>
          <span>Get in Touch</span>
        </div>
        <h2 class="contact-title">Let's Build Something Exceptional Together</h2>
        <p class="contact-subtitle">
          Have an interesting project, architectural challenge, or role in mind? Reach out directly via email, phone, or any of the channels below.
        </p>
      </div>

      <div class="contact-channels-grid">
        <!-- Email Box with Copy Button -->
        <div class="channel-card">
          <div class="channel-icon icon-green">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
          </div>
          <div class="channel-details">
            <span class="channel-label">Direct Email</span>
            <a href="mailto:bktapan16@gmail.com" class="channel-val font-mono">bktapan16@gmail.com</a>
          </div>
          <button id="copy-email-btn" class="btn btn-secondary btn-sm copy-btn" data-email="bktapan16@gmail.com" aria-label="Copy email address to clipboard">
            <span class="copy-text">Copy</span>
            <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
              <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
            </svg>
          </button>
        </div>

        <!-- Phone Box -->
        <div class="channel-card">
          <div class="channel-icon icon-cyan">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
          </div>
          <div class="channel-details">
            <span class="channel-label">Direct Phone</span>
            <a href="tel:+9779849716660" class="channel-val font-mono">+977-984-971-6660</a>
          </div>
          <a href="tel:+9779849716660" class="btn btn-secondary btn-sm" aria-label="Call Tapan">
            <span>Call</span>
          </a>
        </div>

        <!-- Location Box -->
        <div class="channel-card location-card">
          <div class="channel-icon icon-purple">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
          </div>
          <div class="channel-details">
            <span class="channel-label">Location & Timezone</span>
            <span class="channel-val">Patan Dhoka, Lalitpur, Nepal</span>
            <span class="channel-subval font-mono">NPT • UTC+5:45</span>
          </div>
        </div>
      </div>

      <!-- Social Links Row -->
      <div class="social-links-wrapper">
        <span class="social-label font-mono">Connect Across Networks:</span>
        <div class="social-icons-group">
          <!-- GitHub -->
          <a href="https://github.com/tapanbk" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Tapan on GitHub" title="GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>

          <!-- LinkedIn -->
          <a href="https://www.linkedin.com/in/tapanbk/" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Tapan on LinkedIn" title="LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
              <rect width="4" height="12" x="2" y="9"></rect>
              <circle cx="4" cy="4" r="2"></circle>
            </svg>
          </a>

          <!-- Website -->
          <a href="https://tapanbk.com.np/" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Tapan's personal website" title="Website">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" x2="22" y1="12" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </a>

          <!-- X / Twitter -->
          <a href="https://x.com/tapanbk" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Tapan on X (Twitter)" title="X / Twitter">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
              <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
            </svg>
          </a>

          <!-- Facebook -->
          <a href="https://www.facebook.com/tapanbk" target="_blank" rel="noopener noreferrer" class="social-icon-btn" aria-label="Tapan on Facebook" title="Facebook">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-card {
    background: var(--contact-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-xl);
    padding: clamp(2rem, 5vw, 3.5rem);
  }

  .contact-header {
    margin-bottom: clamp(2rem, 4vw, 3rem);
    text-align: left;
  }

  .contact-title {
    margin-bottom: var(--space-sm);
  }

  .contact-subtitle {
    color: var(--color-muted);
    font-size: clamp(1rem, 2vw, 1.125rem);
    max-width: 650px;
  }

  .contact-channels-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  @media (min-width: 860px) {
    .contact-channels-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .channel-card {
    background: var(--channel-card-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-lg);
    padding: 20px;
    display: flex;
    align-items: center;
    gap: 16px;
    transition: all 200ms ease;
  }

  .channel-card:hover {
    border-color: rgba(34, 197, 94, 0.3);
    background: var(--color-card);
  }

  .channel-icon {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-green {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  .icon-cyan {
    background: rgba(56, 189, 248, 0.12);
    color: var(--color-cyan);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .icon-purple {
    background: rgba(168, 85, 247, 0.12);
    color: var(--color-purple);
    border: 1px solid rgba(168, 85, 247, 0.25);
  }

  .channel-details {
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    min-width: 0;
  }

  .channel-label {
    font-size: 0.75rem;
    color: var(--color-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .channel-val {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-foreground);
    line-height: 1.4;
    word-break: break-word;
  }

  .channel-subval {
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-top: 3px;
  }

  a.channel-val:hover {
    color: var(--color-accent);
  }

  .copy-btn {
    flex-shrink: 0;
  }

  /* Social links */
  .social-links-wrapper {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-card-border);
    flex-wrap: wrap;
    gap: 16px;
  }

  .social-label {
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  .social-icons-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .social-icon-btn {
    width: 42px;
    height: 42px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--badge-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    color: var(--color-text-body);
    transition: all 180ms ease;
  }

  .social-icon-btn:hover {
    background: var(--color-accent-subtle);
    border-color: rgba(34, 197, 94, 0.35);
    color: var(--color-accent);
    transform: translateY(-2px);
  }
</style>

<script>
  const copyBtn = document.getElementById('copy-email-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'bktapan16@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        const textSpan = copyBtn.querySelector('.copy-text');
        if (textSpan) {
          const originalText = textSpan.textContent;
          textSpan.textContent = 'Copied!';
          copyBtn.style.borderColor = 'var(--color-accent)';
          copyBtn.style.color = 'var(--color-accent)';

          setTimeout(() => {
            textSpan.textContent = originalText;
            copyBtn.style.borderColor = '';
            copyBtn.style.color = '';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy email', err);
      }
    });
  }
</script>
