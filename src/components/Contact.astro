---
// src/components/Contact.astro
---

<section id="contact" class="section-wrapper">
  <div class="container">
    <div class="section-header reveal-on-scroll">
      <div class="section-badge">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6Z"></path>
          <path d="m22 10-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10"></path>
        </svg>
        <span>Get in Touch</span>
      </div>
      <h2 class="section-title">Let's Build Something <span class="gradient-text">Exceptional Together</span></h2>
      <p class="section-subtitle">
        Have an engineering challenge, high-scale architecture project, or a senior role in mind? Reach out directly via WhatsApp, email, or connect across networks.
      </p>
    </div>

    <!-- 2-Column Split Bento Layout -->
    <div class="contact-grid">
      <!-- Left Column: Direct Channels & Presence -->
      <div class="contact-left-col">
        <!-- 1. Collaboration & Advisory Card -->
        <div class="bento-card collaboration-card reveal-on-scroll delay-100">
          <div class="card-glow-corner"></div>
          <div class="collab-header">
            <span class="collab-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
              <span>Collaboration & Advisory</span>
            </span>
            <span class="collab-meta-item">24h Turnaround</span>
          </div>
          <h3 class="avail-title">Senior Engineering & Architecture Leadership</h3>
          <p class="avail-desc">
            Partnering with engineering teams to architect scalable cloud systems, streamline backend microservices, and deliver high-impact web products.
          </p>
          <div class="avail-meta">
            <span class="avail-meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
              </svg>
              <span>Python • Django • Angular • AWS</span>
            </span>
            <span class="avail-meta-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <span>NPT • UTC+5:45</span>
            </span>
          </div>
        </div>

        <!-- 2. Single Unified Channels Container (Email, Phone, Base combined) -->
        <div class="bento-card channels-master-card reveal-on-scroll delay-200">
          <div class="channels-master-header">
            <div class="channels-title-wrap">
              <div class="channel-dot-pulse"></div>
              <span class="channels-title">Direct Communication Channels</span>
            </div>
            <span class="channels-meta">Primary Points of Contact</span>
          </div>

          <div class="channels-list">
            <!-- Row 1: Direct Email -->
            <div class="channel-row">
              <div class="channel-lead">
                <div class="channel-icon-box icon-green">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                  </svg>
                </div>
                <div class="channel-text">
                  <span class="channel-label">Direct Email</span>
                  <a href="mailto:bktapan16@gmail.com" class="channel-value" title="Click to email bktapan16@gmail.com">bktapan16@gmail.com</a>
                </div>
              </div>

              <div class="channel-actions">
                <button 
                  id="copy-email-btn" 
                  class="channel-action-btn" 
                  data-email="bktapan16@gmail.com" 
                  aria-label="Copy email address"
                  title="Copy email to clipboard"
                >
                  <svg class="copy-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                    <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                  </svg>
                  <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                  <span class="tooltip-bubble" id="copy-tooltip">Copy</span>
                </button>

                <a href="mailto:bktapan16@gmail.com" class="channel-action-btn" aria-label="Open email client" title="Open mail client">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 3h6v6"></path>
                    <path d="M10 14 21 3"></path>
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Row 2: Direct Phone / Call & WhatsApp -->
            <div class="channel-row">
              <div class="channel-lead">
                <div class="channel-icon-box icon-cyan">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                  </svg>
                </div>
                <div class="channel-text">
                  <span class="channel-label">Direct Phone / Call</span>
                  <a href="tel:+9779849716660" class="channel-value" title="Call +977-984-971-6660">+977-984-971-6660</a>
                </div>
              </div>

              <div class="channel-actions">
                <a href="tel:+9779849716660" class="channel-action-btn" aria-label="Call +977-984-971-6660 directly" title="Call directly">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m3 11 18-5v12L3 14v-3z"></path>
                    <path d="M11.6 16.8a3 3 0 1 1-5.8-1.6"></path>
                  </svg>
                </a>

                <a href="https://wa.me/9779849716660" target="_blank" rel="noopener noreferrer" class="channel-action-btn action-whatsapp" aria-label="Chat on WhatsApp" title="Chat on WhatsApp">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.01-1.24-.74-.66-1.25-1.48-1.39-1.73-.14-.25-.01-.39.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.05s.89 2.38 1.01 2.54c.12.17 1.74 2.66 4.22 3.73.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z"/>
                  </svg>
                </a>
              </div>
            </div>

            <!-- Row 3: Engineering Base -->
            <div class="channel-row">
              <div class="channel-lead">
                <div class="channel-icon-box icon-purple">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                </div>
                <div class="channel-text">
                  <span class="channel-label">Engineering Base</span>
                  <span class="channel-value">Patan Dhoka, Lalitpur, Nepal</span>
                </div>
              </div>

              <div class="channel-actions">
                <span class="timezone-pill">NPT • UTC+5:45</span>
              </div>
            </div>
          </div>
        </div>

        <!-- 3. Connect Across Networks (Simple with Icons) -->
        <div class="bento-card social-simple-card reveal-on-scroll delay-250">
          <div class="social-simple-header">
            <span class="social-simple-label">Connect Across Networks</span>
            <span class="social-simple-meta">Direct Links</span>
          </div>

          <div class="social-icons-row">
            <!-- GitHub -->
            <a href="https://github.com/tapanbk" target="_blank" rel="noopener noreferrer" class="social-icon-btn btn-gh" aria-label="GitHub Profile" title="GitHub (@tapanbk)">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
              <span class="tooltip-bubble">GitHub</span>
            </a>

            <!-- LinkedIn -->
            <a href="https://www.linkedin.com/in/tapanbk/" target="_blank" rel="noopener noreferrer" class="social-icon-btn btn-li" aria-label="LinkedIn Profile" title="LinkedIn (in/tapanbk)">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              <span class="tooltip-bubble">LinkedIn</span>
            </a>

            <!-- WhatsApp -->
            <a href="https://wa.me/9779849716660" target="_blank" rel="noopener noreferrer" class="social-icon-btn btn-wa" aria-label="Chat on WhatsApp" title="WhatsApp (+977 984-971-6660)">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.01-1.24-.74-.66-1.25-1.48-1.39-1.73-.14-.25-.01-.39.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.05s.89 2.38 1.01 2.54c.12.17 1.74 2.66 4.22 3.73.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z"/>
              </svg>
              <span class="tooltip-bubble">WhatsApp</span>
            </a>

            <!-- X (Twitter) -->
            <a href="https://x.com/tapanbk" target="_blank" rel="noopener noreferrer" class="social-icon-btn btn-x" aria-label="X Twitter Profile" title="X / Twitter (@tapanbk)">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4l11.733 16h4.267l-11.733 -16z"></path>
                <path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"></path>
              </svg>
              <span class="tooltip-bubble">X (Twitter)</span>
            </a>

            <!-- Personal Website -->
            <a href="https://bktapan.com.np/" target="_blank" rel="noopener noreferrer" class="social-icon-btn btn-web" aria-label="Personal Website" title="Website (bktapan.com.np)">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" x2="22" y1="12" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
              <span class="tooltip-bubble">Website</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Direct WhatsApp & Instant Inquiry Dispatch (Replaces fake email form) -->
      <div class="contact-right-col">
        <div class="bento-card inquiry-form-card reveal-on-scroll delay-150">
          <div class="card-glow-corner"></div>

          <div class="form-header">
            <div class="form-header-badge">
              <span class="status-dot"></span>
              <span>Direct WhatsApp Dispatch</span>
            </div>
            <h3 class="form-title">Start a Direct WhatsApp Conversation</h3>
            <p class="form-subtitle">
              Choose your topic, enter your details or project requirements, and launch directly into WhatsApp with your message pre-formatted. Instant, transparent, and zero email wait times.
            </p>
          </div>

          <form id="whatsapp-inquiry-form" class="inquiry-form" novalidate>
            <!-- Topic Chips Selection -->
            <div class="form-group">
              <label class="form-label">Inquiry Topic</label>
              <div class="topic-chips-group" role="radiogroup" aria-label="Inquiry Topic">
                <button type="button" class="topic-chip active" data-topic="Senior Full-Stack Role">
                  <span>💼 Senior Role</span>
                </button>
                <button type="button" class="topic-chip" data-topic="Architecture & Advisory">
                  <span>⚡ Architecture</span>
                </button>
                <button type="button" class="topic-chip" data-topic="Web & Cloud Platform">
                  <span>🛠️ Web / Cloud</span>
                </button>
                <button type="button" class="topic-chip" data-topic="General Inquiry">
                  <span>👋 Say Hello</span>
                </button>
              </div>
            </div>

            <!-- Name and Organization Input -->
            <div class="form-group">
              <label for="inquiry-name" class="form-label">Your Name or Organization <span class="label-optional">(Optional)</span></label>
              <input 
                type="text" 
                id="inquiry-name" 
                name="name" 
                class="form-input" 
                placeholder="e.g. Alex Morgan • Engineering Director at Acme" 
              />
            </div>

            <!-- Message Area -->
            <div class="form-group">
              <label for="inquiry-message" class="form-label">Project Scope or Message Details</label>
              <textarea 
                id="inquiry-message" 
                name="message" 
                class="form-textarea" 
                rows="4" 
                placeholder="Share a brief overview of your product, tech stack, team goals, or timeline..."
              ></textarea>
            </div>

            <!-- Action Buttons: WhatsApp Primary, Default Email Client, Copy Text -->
            <div class="form-actions">
              <button type="submit" class="btn btn-whatsapp form-submit-btn" id="launch-whatsapp-btn" title="Launch direct WhatsApp chat">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.36c0-4.54 3.7-8.24 8.24-8.24m4.52 11.63c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.01-1.24-.74-.66-1.25-1.48-1.39-1.73-.14-.25-.01-.39.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.84-.86 2.05s.89 2.38 1.01 2.54c.12.17 1.74 2.66 4.22 3.73.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.1-.23-.17-.48-.29z"/>
                </svg>
                <span>Chat on WhatsApp</span>
              </button>

              <!-- Default Email Client (Native mailto: link, opens user's default email app) -->
              <a 
                href="mailto:bktapan16@gmail.com" 
                class="btn btn-secondary form-email-btn" 
                id="email-client-btn" 
                title="Open in default email client"
              >
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                  <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
                <span>Email Client</span>
              </a>

              <!-- Copy Note to Clipboard -->
              <button type="button" class="btn btn-secondary form-copy-btn" id="copy-draft-btn" title="Copy formatted note to clipboard">
                <svg class="copy-draft-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                  <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
                </svg>
                <svg class="check-draft-icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="display: none;">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
                <span class="copy-draft-text">Copy Note</span>
              </button>
            </div>

            <div class="form-note">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
              <span>Direct 1-click WhatsApp redirect or default email client. Zero backend tracking.</span>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 2-Column Split Grid / Mobile Reordering */
  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: stretch;
  }

  /* On mobile (< 960px):
     display: contents unrolls the column containers so that all cards become direct flex children of .contact-grid.
     This places Direct Communication Channels and Connect Across Networks at the very bottom on mobile devices! */
  @media (max-width: 959px) {
    .contact-left-col,
    .contact-right-col {
      display: contents;
    }

    /* 1. Collaboration & Advisory (at top) */
    .collaboration-card {
      order: 1;
    }

    /* 2. Direct WhatsApp & Instant Inquiry Form */
    .inquiry-form-card {
      order: 2;
    }

    /* 3. Direct Communication Channels (at bottom on mobile) */
    .channels-master-card {
      order: 3;
    }

    /* 4. Connect Across Networks (at bottom on mobile) */
    .social-simple-card {
      order: 4;
    }
  }

  /* On desktop (>= 960px): Standard 2-column balanced split */
  @media (min-width: 960px) {
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      align-items: start;
    }

    .contact-left-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .contact-right-col {
      display: block;
    }

    .collaboration-card,
    .inquiry-form-card,
    .channels-master-card,
    .social-simple-card {
      order: unset;
    }
  }

  /* Collaboration Card */
  .collaboration-card {
    border-color: rgba(56, 189, 248, 0.25);
    background: var(--contact-card-bg);
  }

  .collaboration-card:hover {
    border-color: rgba(56, 189, 248, 0.45);
  }

  .collab-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 12px;
  }

  .collab-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: rgba(56, 189, 248, 0.1);
    border: 1px solid rgba(56, 189, 248, 0.25);
    color: var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  html[data-theme="light"] .collab-badge {
    background: rgba(2, 132, 199, 0.08);
    border-color: rgba(2, 132, 199, 0.25);
    color: #0284C7;
  }

  .collab-meta-item {
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .avail-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .avail-desc {
    font-size: 0.9375rem;
    color: var(--color-text-body);
    line-height: 1.65;
    margin-bottom: 16px;
  }

  .avail-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px solid var(--color-card-border);
  }

  .avail-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: var(--color-muted);
  }

  .avail-meta-item svg {
    color: var(--color-accent);
  }

  /* ==========================================================================
     Single Master Container for Channels (Email, Phone, Base)
     ========================================================================== */
  .channels-master-card {
    padding: 20px 22px;
    background: var(--contact-card-bg);
    border: 1px solid var(--color-card-border);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: all 180ms ease;
  }

  .channels-master-card:hover {
    border-color: rgba(34, 197, 94, 0.35);
  }

  .channels-master-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-card-border);
  }

  .channels-title-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .channel-dot-pulse {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .channels-title {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-foreground);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .channels-meta {
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  .channels-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .channel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    background: var(--badge-bg);
    border: 1px solid var(--color-card-border);
    border-radius: var(--radius-md);
    transition: all 150ms ease;
  }

  .channel-row:hover {
    background: var(--color-card);
    border-color: rgba(56, 189, 248, 0.3);
  }

  .channel-lead {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
  }

  .channel-icon-box {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .icon-green {
    background: var(--color-accent-subtle);
    color: var(--color-accent);
    border: 1px solid rgba(34, 197, 94, 0.25);
  }

  .icon-cyan {
    background: rgba(56, 189, 248, 0.12);
    color: var(--color-cyan);
    border: 1px solid rgba(56, 189, 248, 0.25);
  }

  .icon-purple {
    background: rgba(168, 85, 247, 0.12);
    color: var(--color-purple);
    border: 1px solid rgba(168, 85, 247, 0.25);
  }

  .channel-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .channel-label {
    font-size: 0.6875rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 2px;
  }

  .channel-value {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-foreground);
    line-height: 1.3;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  a.channel-value:hover {
    color: var(--color-accent);
  }

  .channel-actions {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
  }

  .channel-action-btn {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-sm);
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
    color: var(--color-text-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 200ms cubic-bezier(0.16, 1, 0.3, 1),
                background-color 160ms ease,
                border-color 160ms ease,
                color 160ms ease,
                box-shadow 200ms ease;
    padding: 0;
    text-decoration: none;
  }

  .channel-action-btn svg {
    transition: transform 200ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: center;
  }

  .channel-action-btn:hover {
    background: var(--color-accent-subtle);
    border-color: rgba(34, 197, 94, 0.5);
    color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px -2px rgba(34, 197, 94, 0.25);
  }

  .channel-action-btn:hover svg {
    transform: scale(1.15);
  }

  .channel-action-btn:active {
    transform: translateY(0) scale(0.96);
  }

  .channel-action-btn.action-whatsapp:hover {
    background: rgba(37, 211, 102, 0.15);
    border-color: rgba(37, 211, 102, 0.55);
    color: #25D366;
    box-shadow: 0 6px 14px -2px rgba(37, 211, 102, 0.3);
  }

  .timezone-pill {
    font-size: 0.6875rem;
    color: var(--color-muted);
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: var(--color-card);
    border: 1px solid var(--color-card-border);
    white-space: nowrap;
  }

  /* Universal modern tooltip bubble with downward caret */
  .tooltip-bubble {
    position: absolute;
    bottom: calc(100% + 9px);
    left: 50%;
    transform: translateX(-50%) translateY(5px) scale(0.92);
    background: #0B132B;
    color: #FFFFFF;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.02em;
    padding: 4px 9px;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.15);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition: opacity 180ms ease, transform 180ms cubic-bezier(0.16, 1, 0.3, 1), visibility 180ms ease;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.35);
    z-index: 30;
  }

  .tooltip-bubble::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border-width: 5px 5px 0 5px;
    border-style: solid;
    border-color: #0B132B transparent transparent transparent;
  }

  .channel-action-btn:hover .tooltip-bubble,
  .channel-action-btn.copied .tooltip-bubble {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(-2px) scale(1);
  }

  /* For social buttons: position tooltip bubble below the button with upward caret so it never overlaps the card header */
  .social-icon-btn .tooltip-bubble {
    top: calc(100% + 9px);
    bottom: auto;
    transform: translateX(-50%) translateY(-5px) scale(0.92);
  }

  .social-icon-btn .tooltip-bubble::after {
    top: auto;
    bottom: 100%;
    border-width: 0 5px 5px 5px;
    border-color: transparent transparent #0B132B transparent;
  }

  .social-icon-btn:hover .tooltip-bubble,
  .social-icon-btn:focus-visible .tooltip-bubble {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(2px) scale(1);
  }

  html[data-theme="light"] .tooltip-bubble {
    background: #0F172A;
    color: #FFFFFF;
    border-color: #334155;
    box-shadow: 0 8px 18px rgba(15, 23, 42, 0.2);
  }

  html[data-theme="light"] .tooltip-bubble::after {
    border-color: #0F172A transparent transparent transparent;
  }

  html[data-theme="light"] .social-icon-btn .tooltip-bubble::after {
    border-color: transparent transparent #0F172A transparent;
  }

  /* ==========================================================================
     Connect Across Networks (Simple with Icons)
     ========================================================================== */
  .social-simple-card {
    padding: 18px 22px 24px;
    background: var(--contact-card-bg);
    border: 1px solid var(--color-card-border);
    display: flex;
    flex-direction: column;
    gap: 14px;
    overflow: visible; /* Prevents tooltips and elevated hover states from clipping */
    transition: border-color 200ms ease, box-shadow 200ms ease;
  }

  .social-simple-card:hover {
    border-color: rgba(56, 189, 248, 0.35);
  }

  .social-simple-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .social-simple-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-foreground);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .social-simple-meta {
    font-size: 0.6875rem;
    color: var(--color-muted);
  }

  .social-icons-row {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }

  /* Sibling focus: lightly soften non-hovered icons when browsing the row */
  .social-icons-row:hover .social-icon-btn:not(:hover) {
    opacity: 0.65;
    transform: scale(0.97);
  }

  .social-icon-btn {
    position: relative;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: var(--badge-bg);
    border: 1px solid var(--color-card-border);
    color: var(--color-text-body);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
                background 200ms ease,
                border-color 200ms ease,
                color 200ms ease,
                box-shadow 220ms ease,
                opacity 200ms ease;
    text-decoration: none;
    cursor: pointer;
  }

  .social-icon-btn svg {
    transition: transform 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
    transform-origin: center;
  }

  .social-icon-btn:hover {
    transform: translateY(-4px) scale(1.06);
    z-index: 5;
  }

  .social-icon-btn:hover svg {
    transform: scale(1.18);
  }

  .social-icon-btn:active {
    transform: translateY(-1px) scale(0.97);
    transition-duration: 75ms;
  }

  .social-icon-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  /* --- Brand-Specific Hover Signatures (Dark Mode) --- */
  .social-icon-btn.btn-gh:hover {
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.5);
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05));
    box-shadow: 0 10px 24px -2px rgba(255, 255, 255, 0.2), 0 4px 10px rgba(0, 0, 0, 0.4);
  }

  .social-icon-btn.btn-li:hover {
    color: #38BDF8;
    border-color: rgba(10, 102, 194, 0.65);
    background: radial-gradient(circle at 50% 0%, rgba(10, 102, 194, 0.28), rgba(10, 102, 194, 0.08));
    box-shadow: 0 10px 24px -2px rgba(10, 102, 194, 0.45), 0 4px 10px rgba(0, 0, 0, 0.4);
  }

  .social-icon-btn.btn-wa:hover {
    color: #25D366;
    border-color: rgba(37, 211, 102, 0.65);
    background: radial-gradient(circle at 50% 0%, rgba(37, 211, 102, 0.28), rgba(37, 211, 102, 0.08));
    box-shadow: 0 10px 24px -2px rgba(37, 211, 102, 0.45), 0 4px 10px rgba(0, 0, 0, 0.4);
  }

  .social-icon-btn.btn-x:hover {
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.5);
    background: radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.05));
    box-shadow: 0 10px 24px -2px rgba(255, 255, 255, 0.18), 0 4px 10px rgba(0, 0, 0, 0.4);
  }

  .social-icon-btn.btn-web:hover {
    color: var(--color-accent);
    border-color: rgba(34, 197, 94, 0.65);
    background: radial-gradient(circle at 50% 0%, rgba(34, 197, 94, 0.28), rgba(34, 197, 94, 0.08));
    box-shadow: 0 10px 24px -2px rgba(34, 197, 94, 0.45), 0 4px 10px rgba(0, 0, 0, 0.4);
  }

  /* --- Light Theme Social Styling & Hover Enhancements --- */
  html[data-theme="light"] .social-simple-card {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  html[data-theme="light"] .social-icon-btn {
    background: #F8FAFC;
    border-color: #E2E8F0;
    color: #334155;
  }

  /* GitHub Light Mode Hover: high-contrast dark badge with white icon */
  html[data-theme="light"] .social-icon-btn.btn-gh:hover {
    color: #FFFFFF;
    background: #181717;
    border-color: #181717;
    box-shadow: 0 10px 24px -2px rgba(24, 23, 23, 0.35), 0 4px 8px rgba(24, 23, 23, 0.12);
  }

  /* LinkedIn Light Mode Hover: official LinkedIn blue with tinted background */
  html[data-theme="light"] .social-icon-btn.btn-li:hover {
    color: #0A66C2;
    background: #EFF6FF;
    border-color: rgba(10, 102, 194, 0.55);
    box-shadow: 0 10px 24px -2px rgba(10, 102, 194, 0.28), 0 4px 8px rgba(10, 102, 194, 0.1);
  }

  /* WhatsApp Light Mode Hover: vibrant WhatsApp green with tinted background */
  html[data-theme="light"] .social-icon-btn.btn-wa:hover {
    color: #16A34A;
    background: #F0FDF4;
    border-color: rgba(22, 163, 74, 0.55);
    box-shadow: 0 10px 24px -2px rgba(22, 163, 74, 0.3), 0 4px 8px rgba(22, 163, 74, 0.1);
  }

  /* X / Twitter Light Mode Hover: sleek dark badge with crisp white icon */
  html[data-theme="light"] .social-icon-btn.btn-x:hover {
    color: #FFFFFF;
    background: #0F172A;
    border-color: #0F172A;
    box-shadow: 0 10px 24px -2px rgba(15, 23, 42, 0.35), 0 4px 8px rgba(15, 23, 42, 0.12);
  }

  /* Website Light Mode Hover: crisp emerald accent with tinted background */
  html[data-theme="light"] .social-icon-btn.btn-web:hover {
    color: #15803D;
    background: #F0FDF4;
    border-color: rgba(22, 163, 74, 0.55);
    box-shadow: 0 10px 24px -2px rgba(22, 163, 74, 0.3), 0 4px 8px rgba(22, 163, 74, 0.1);
  }

  /* ==========================================================================
     Right Column: WhatsApp & Project Dispatch
     ========================================================================== */
  .inquiry-form-card {
    padding: clamp(1.5rem, 3.5vw, 2.25rem);
    background: var(--contact-card-bg);
    border: 1px solid var(--color-card-border);
  }

  .form-header {
    margin-bottom: 20px;
  }

  .form-header-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    background: rgba(37, 211, 102, 0.1);
    border: 1px solid rgba(37, 211, 102, 0.3);
    color: #25D366;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 10px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #25D366;
    box-shadow: 0 0 6px #25D366;
  }

  .form-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.3;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
  }

  .form-subtitle {
    font-size: 0.875rem;
    color: var(--color-text-body);
    line-height: 1.6;
  }

  /* Form Elements */
  .inquiry-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-foreground);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .label-optional {
    font-size: 0.6875rem;
    font-weight: 400;
    color: var(--color-muted);
  }

  .topic-chips-group {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .topic-chip {
    padding: 7px 12px;
    font-size: 0.75rem;
    font-weight: 500;
    border-radius: var(--radius-full);
    background: var(--badge-bg);
    border: 1px solid var(--color-card-border);
    color: var(--color-text-body);
    cursor: pointer;
    transition: all 150ms ease;
  }

  .topic-chip:hover {
    border-color: rgba(37, 211, 102, 0.4);
    color: var(--color-foreground);
  }

  .topic-chip.active {
    background: rgba(37, 211, 102, 0.12);
    border-color: rgba(37, 211, 102, 0.5);
    color: #25D366;
    font-weight: 600;
