    gap: 8px;
    background: #25D366;
    color: #06240E;
    font-weight: 700;
    font-size: 0.875rem;
    padding: 11px 20px;
    border-radius: var(--radius-md);
    border: none;
    cursor: pointer;
    transition: all 180ms ease;
    box-shadow: 0 4px 14px rgba(37, 211, 102, 0.25);
  }

  .btn-whatsapp:hover {
    background: #20BA5A;
    transform: translateY(-1px);
    box-shadow: 0 6px 20px rgba(37, 211, 102, 0.35);
  }

  .form-email-btn,
  .form-copy-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 11px 14px;
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    background: var(--badge-bg);
    border: 1px solid var(--color-card-border);
    color: var(--color-text-body);
    border-radius: var(--radius-md);
    text-decoration: none;
    transition: all 150ms ease;
  }

  .form-email-btn:hover,
  .form-copy-btn:hover {
    background: var(--color-card);
    border-color: var(--color-card-hover-border);
    color: var(--color-foreground);
    transform: translateY(-1px);
    text-decoration: none;
  }

  .form-note {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.6875rem;
    color: var(--color-muted);
    margin-top: 4px;
    line-height: 1.4;
  }

  .form-note svg {
    flex-shrink: 0;
    color: #25D366;
  }

  /* Light Theme Adjustments */
  html[data-theme="light"] .channels-master-card,
  html[data-theme="light"] .social-grid-card,
  html[data-theme="light"] .inquiry-form-card {
    background: #FFFFFF;
    border-color: #E2E8F0;
    box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);
  }

  html[data-theme="light"] .channel-row,
  html[data-theme="light"] .network-tile {
    background: #F8FAFC;
    border-color: #E2E8F0;
  }

  html[data-theme="light"] .channel-row:hover,
  html[data-theme="light"] .network-tile:hover {
    background: #FFFFFF;
    border-color: rgba(22, 163, 74, 0.4);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
  }

  html[data-theme="light"] .tile-icon-wrap {
    background: #FFFFFF;
    border-color: #E2E8F0;
  }

  html[data-theme="light"] .channel-action-btn {
    background: #FFFFFF;
    border-color: #CBD5E1;
  }
</style>

<script>
  // 1. Email Copy Button
  const copyBtn = document.getElementById('copy-email-btn');
  const tooltip = document.getElementById('copy-tooltip');

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      const email = copyBtn.getAttribute('data-email') || 'bktapan16@gmail.com';
      try {
        await navigator.clipboard.writeText(email);
        const copyIcon = copyBtn.querySelector('.copy-icon') as HTMLElement;
        const checkIcon = copyBtn.querySelector('.check-icon') as HTMLElement;

        if (copyIcon && checkIcon && tooltip) {
          copyIcon.style.display = 'none';
          checkIcon.style.display = 'block';
          tooltip.textContent = 'Copied!';
          copyBtn.classList.add('copied');
          copyBtn.style.borderColor = 'var(--color-accent)';
          copyBtn.style.color = 'var(--color-accent)';

          setTimeout(() => {
            copyIcon.style.display = 'block';
            checkIcon.style.display = 'none';
            tooltip.textContent = 'Copy';
            copyBtn.classList.remove('copied');
            copyBtn.style.borderColor = '';
            copyBtn.style.color = '';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy email', err);
      }
    });
  }

  // 2. Topic Chips Selection
  const topicChips = document.querySelectorAll('.topic-chip');
  let selectedTopic = 'Senior Full-Stack Role';

  // 3. Message & Mailto Helper
  const nameInput = document.getElementById('inquiry-name') as HTMLInputElement;
  const messageInput = document.getElementById('inquiry-message') as HTMLTextAreaElement;
  const whatsappForm = document.getElementById('whatsapp-inquiry-form') as HTMLFormElement;
  const emailClientBtn = document.getElementById('email-client-btn') as HTMLAnchorElement;
  const copyDraftBtn = document.getElementById('copy-draft-btn');

  function getMessagePayload() {
    const name = nameInput?.value?.trim() || '';
    const msg = messageInput?.value?.trim() || '';
    
    let text = `Hi Tapan!\nTopic: ${selectedTopic}`;
    if (name) {
      text += `\nFrom: ${name}`;
    }
    if (msg) {
      text += `\n\n${msg}`;
    } else {
      text += `\n\nI'd like to connect and discuss an opportunity with you.`;
    }

    return { name, msg, text };
  }

  function updateMailtoLink() {
    if (!emailClientBtn) return;
    const { name, text } = getMessagePayload();
    const subject = `[Inquiry: ${selectedTopic}]${name ? ' from ' + name : ''}`;
    // Standard RFC 6068 CRLF encoding for universal mail client compatibility
    const crlfText = text.replace(/\n/g, '\r\n');
    const mailtoUrl = `mailto:bktapan16@gmail.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(crlfText)}`;
    emailClientBtn.setAttribute('href', mailtoUrl);
  }

  topicChips.forEach((chip) => {
    chip.addEventListener('click', () => {
      topicChips.forEach((c) => c.classList.remove('active'));
      chip.classList.add('active');
      selectedTopic = chip.getAttribute('data-topic') || 'Inquiry';
      updateMailtoLink();
    });
  });

  // Keep mailto href synchronized whenever form fields change
  if (nameInput) nameInput.addEventListener('input', updateMailtoLink);
  if (messageInput) messageInput.addEventListener('input', updateMailtoLink);

  // Initialize mailto href immediately on load
  updateMailtoLink();

  // 4. WhatsApp Direct Launch
  if (whatsappForm) {
    whatsappForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const { text } = getMessagePayload();
      const whatsappUrl = `https://wa.me/9779849716660?text=${encodeURIComponent(text)}`;
      window.open(whatsappUrl, '_blank', 'noopener,noreferrer');
    });
  }

  // 5. Default Email Client Launch
  if (emailClientBtn) {
    // Ensure href is up to date immediately before click/navigation
    emailClientBtn.addEventListener('pointerdown', updateMailtoLink);
    emailClientBtn.addEventListener('click', () => {
      updateMailtoLink();

      // Visual feedback on click
      const prevBorder = emailClientBtn.style.borderColor;
      const prevColor = emailClientBtn.style.color;
      emailClientBtn.style.borderColor = 'var(--color-accent)';
      emailClientBtn.style.color = 'var(--color-accent)';
      setTimeout(() => {
        emailClientBtn.style.borderColor = prevBorder;
        emailClientBtn.style.color = prevColor;
      }, 2000);
    });
  }

  // 6. Copy Formatted Note
  if (copyDraftBtn) {
    copyDraftBtn.addEventListener('click', async () => {
      const { text } = getMessagePayload();
      try {
        await navigator.clipboard.writeText(text);
        const textSpan = copyDraftBtn.querySelector('.copy-draft-text');
        const copyIcon = copyDraftBtn.querySelector('.copy-draft-icon') as HTMLElement;
        const checkIcon = copyDraftBtn.querySelector('.check-draft-icon') as HTMLElement;

        if (textSpan && copyIcon && checkIcon) {
          const originalText = textSpan.textContent;
          textSpan.textContent = 'Copied!';
          copyIcon.style.display = 'none';
          checkIcon.style.display = 'inline-block';
          copyDraftBtn.style.borderColor = '#25D366';
          copyDraftBtn.style.color = '#25D366';

          setTimeout(() => {
            textSpan.textContent = originalText;
            copyIcon.style.display = 'inline-block';
            checkIcon.style.display = 'none';
            copyDraftBtn.style.borderColor = '';
            copyDraftBtn.style.color = '';
          }, 2000);
        }
      } catch (err) {
        console.error('Failed to copy message', err);
      }
    });
  }
</script>
