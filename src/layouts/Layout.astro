---
// src/layouts/Layout.astro
import '../styles/global.css';
import { getYearsOfExperience } from '../utils/experience';

const dynamicExpYears = getYearsOfExperience();

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Tapan B.K. | Full Stack Software Engineer",
  description = `Tapan B.K. is a senior Full Stack Software Engineer at Outcode LLC with ${dynamicExpYears}+ years experience in Python, Django, Angular, cloud infrastructure, and distributed web platforms.`
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="theme-color" content="#090D16" />
  <meta name="author" content="Tapan B.K." />
  <meta name="description" content={description} />
  <meta name="keywords" content="Tapan BK, TapanBK, Full Stack Software Engineer, Python Engineer, Django Developer, Angular, Outcode LLC, Nepal" />

  <!-- Theme Initialization (Zero FOUC) -->
  <script is:inline>
    (function() {
      const storedTheme = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      const theme = storedTheme || (prefersDark ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
      const metaThemeColor = document.querySelector('meta[name="theme-color"]');
      if (metaThemeColor) {
        metaThemeColor.setAttribute('content', theme === 'dark' ? '#090D16' : '#F8FAFC');
      }
    })();
  </script>

  <!-- Open Graph / Social Sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content="https://tapanbk.com.np" />
  <meta property="og:image" content="/img/about/1.jpg" />

  <!-- Twitter Meta -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@tapanbk" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="/img/about/1.jpg" />

  <title>{title}</title>

  <!-- Google Fonts Preconnect for Plus Jakarta Sans, Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Favicons -->
  <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png" />
  <link rel="manifest" href="/img/favicon/site.webmanifest" />
</head>
<body>
  <slot />

  <!-- Smooth Scroll Reveal Controller -->
  <script is:inline>
    (function() {
      function setupScrollReveal() {
        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
            el.classList.add('is-revealed');
          });
          return;
        }

        // Immediately reveal hero above-the-fold elements so they don't wait for scroll
        document.querySelectorAll('#hero .reveal-on-scroll').forEach(function(el) {
          el.classList.add('is-revealed');
        });

        if (!('IntersectionObserver' in window)) {
          document.querySelectorAll('.reveal-on-scroll').forEach(function(el) {
            el.classList.add('is-revealed');
          });
          return;
        }

        var revealObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              revealObserver.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.05,
          rootMargin: '0px 0px 40px 0px'
        });

        document.querySelectorAll('.reveal-on-scroll:not(.is-revealed)').forEach(function(el) {
          revealObserver.observe(el);
        });
      }

      function syncDynamicExperience() {
        var currentYear = new Date().getFullYear();
        var expYears = Math.max(1, currentYear - 2016);
        var outcodeYears = Math.max(1, currentYear - 2020);
        document.querySelectorAll('[data-dynamic-exp="years"]').forEach(function(el) {
          el.textContent = String(expYears);
        });
        document.querySelectorAll('[data-dynamic-exp="badge"]').forEach(function(el) {
          el.textContent = expYears + '+';
        });
        document.querySelectorAll('[data-dynamic-exp="badge-years"]').forEach(function(el) {
          el.textContent = expYears + '+ Years';
        });
        document.querySelectorAll('[data-dynamic-exp="badge-years-text"]').forEach(function(el) {
          el.textContent = expYears + '+ years';
        });
        document.querySelectorAll('[data-dynamic-exp="outcode-years"]').forEach(function(el) {
          el.textContent = outcodeYears + '+ Years';
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          setupScrollReveal();
          syncDynamicExperience();
        });
      } else {
        setupScrollReveal();
        syncDynamicExperience();
      }
    })();
  </script>
</body>
</html>
